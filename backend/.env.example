# ===== Anthropic Claude API =====
# あなた自身の API キーを設定してください（https://console.anthropic.com/ で取得）
# 未設定の場合、AI 機能はスタブ（ダミー応答）で動作します。
ANTHROPIC_API_KEY=
# 使用モデル（省略時は下記デフォルト）
ANTHROPIC_MODEL=claude-opus-4-8

# ===== サーバ =====
PORT=4000
# フロントエンドの URL（CORS 許可）。複数はカンマ区切り。'*' で全許可（開発用）。
# 同一オリジン配信（SERVE_STATIC=true）の場合は自分の公開 URL を入れる。
CLIENT_ORIGIN=http://localhost:5173

# ===== 認証 =====
# トークン署名シークレット【本番では必須】。長いランダム文字列を設定。
# 例: openssl rand -base64 48
JWT_SECRET=
# トークン有効期限（秒）。既定 7 日。
TOKEN_TTL_SEC=604800
# 新規登録に招待コードを要求（公開デプロイでの無差別登録防止）。空なら誰でも登録可。
SIGNUP_CODE=

# ===== データベース =====
# SQLite ファイルパス（省略時 data/app.sqlite）。
# クラウドでは永続ボリューム上のパスにする（例 /data/app.sqlite）。
DB_PATH=data/app.sqlite
# 【将来用】PostgreSQL 接続文字列。現状は未実装の切替ポイント（repositories.ts のコメント参照）。
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ===== 静的配信（単一サービスデプロイ）=====
# true にすると Express が frontend/dist を配信（バック1つでフロントも提供）。
SERVE_STATIC=false

# ===== スケジューラ（node-cron）=====
# 毎朝のニュース収集＋レポート生成（全ユーザー対象）の実行時刻（cron 形式）。
# 既定: 平日 07:30。 "分 時 日 月 曜日"
NEWS_CRON=30 7 * * 1-5
# タイムゾーン
CRON_TZ=Asia/Tokyo
# 起動時に自動でスケジューラを有効化するか
ENABLE_SCHEDULER=true
